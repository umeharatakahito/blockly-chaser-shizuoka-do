<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="utf-8">
  <title>CHaser ボット対戦</title>
  <link rel="icon" href="/images/favicon.ico">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/menu-watching.css' />
  <link rel='stylesheet' href='/stylesheets/menu-pick.css' />
  <link rel='stylesheet' href='/stylesheets/animation.css' />
  <%- include('./common/config-init') %>
</head>

<body>
  <%- include('./common/config', {LNG: C_LNG}) %>

  <div class="header">
    <div class="back_page">
      <div class="back_button"><a href="/"></a></div>
    </div>
    <div class="control_area">
      <div class="page_title">
        <h1><span class="page_title_span">ボット対戦</span><%- title %></h1>
      </div>
      <div class="control_button">
        <button id="configButton" title="<%- C_LNG["CONFIG"] %>"></button>
      </div>
    </div>
  </div>

  <div class="content">
    <div class="pick_area">
      <div class="pick_left">
        <div class="pick_card">
          <h2>1. マップを選ぶ</h2>
          <div id="map_list" class="pick_list"></div>
        </div>
        <div class="pick_card">
          <h2>ランキング (ボットに勝った人)</h2>
          <div id="ranking"></div>
        </div>
      </div>

      <div class="pick_right">
        <div class="pick_card">
          <h2>2. ボットの強さを選ぶ</h2>
          <div class="level_row">
            <span class="level_value" id="level_value">L 10</span>
            <input type="range" id="level_range" min="1" max="30" value="10">
          </div>
          <div class="level_desc" id="level_desc"></div>
          <div class="level_quick" id="level_quick"></div>

          <h2>3. 対戦する</h2>
          <div id="map_preview"></div>
          <div id="map_name" class="pick_item_name" style="margin:8px 0"></div>
          <button id="go_button" class="pick_go" disabled>マップを選んでください</button>
          <div class="pick_note">
            次の画面で、あなたのプログラム(.blch)を cool 側に読み込みます。<br>
            ボットは hot(後攻)です。勝つと名前をランキングとゴーストに残せます。
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/javascripts/map_preview.js"></script>
  <script src="/javascripts/menu-bot.js"></script>
</body>

</html>
