<!DOCTYPE html>
<html lang="ja">

<head>
  <%- include('./common/page-head', {pageTitle: 'CHaser エントリー'}) %>
</head>

<body class="admin_body">

  <div class="header">
    <div class="back_page">
      <div class="back_button"><a href="/"></a></div>
    </div>
    <div class="control_area">
      <div class="page_title">
        <h1><span class="page_title_span">大会</span><%- title %></h1>
      </div>
    </div>
  </div>

  <div class="admin_area">
    <div id="notice"></div>

    <div class="admin_card">
      <h2 class="admin_card_title">大会にエントリーする</h2>
      <p class="admin_note">
        対戦表に載る名前を登録します。名前は20文字まで。あとでプログラムを提出するときにも同じ名前を使います。
      </p>
      <div class="admin_field">
        <label for="name">選手名 (対戦表に載る名前) <strong>必須</strong></label>
        <input class="admin_text" type="text" id="name" maxlength="20" placeholder="例: しずおか たろう">
      </div>
      <div class="admin_field_row">
        <div class="admin_field">
          <label for="school">学校・所属</label>
          <input class="admin_text" type="text" id="school" maxlength="50" placeholder="例: 静岡中学校">
        </div>
        <div class="admin_field">
          <label for="grade">学年</label>
          <input class="admin_text" type="text" id="grade" maxlength="20" placeholder="例: 中2">
        </div>
      </div>
      <div class="admin_field">
        <label for="note">運営への連絡 (任意)</label>
        <textarea class="admin_textarea" id="note" maxlength="200"></textarea>
      </div>
      <button class="admin_button" id="submit">エントリーする</button>
    </div>

    <div class="admin_card">
      <h2 class="admin_card_title">エントリー済み <span id="entry_count"></span></h2>
      <div id="entry_list"></div>
    </div>
  </div>

  <script src="/javascripts/entry.js"></script>

</body>

</html>
