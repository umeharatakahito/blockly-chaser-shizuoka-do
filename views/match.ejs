<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>CHaser Match</title>
  <link rel="icon" href="/images/favicon.ico">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/animation.css' />
  <link rel='stylesheet' href='/stylesheets/menu.css' />
  <link rel='stylesheet' href='/stylesheets/game-board.css' />
  <link rel='stylesheet' href='/stylesheets/match.css' />
  <link rel='stylesheet' href='/stylesheets/match-extra.css' />

  <script src="/socket.io/socket.io.js"></script>
  <script src="/javascripts/jquery-3.4.1.min.js"></script>

  <script src="/javascripts/howler.min.js"></script>

  <script src="/javascripts/match.js"></script>
  <script src="/javascripts/game_board.js"></script>


</head>

<body class="animation_stop">
  <div class="header">

    <div class="back_page">
      <div class="back_button"><a id="back_link" href="/vs"></a></div>
    </div>
    <div class="control_area">
      <div class="page_title">
        <h1><span class="page_title_span">対戦</span>
          <div id="server_name"></div>
        </h1>
      </div>
      <div class="control_button">
        <button id="fullscreenButton" onclick="reqFullscreen('contents_area')" class="notext" title="最大化"></button>
      </div>
    </div>

  </div>
  <div id="contents_area">
    <div id="ready_area">
      <div id="cool_ready_title">cool</div>
      <div id="cool_ready">
        <iframe id="cool_player_iframe" class="player_iframe"></iframe>
      </div>
      <div id="hot_ready_title">hot</div>
      <div id="hot_ready">
        <iframe id="hot_player_iframe" class="player_iframe"></iframe>
      </div>
      <div id="game_start" class="display_init">ゲームスタート</div>
    </div>
    <div id="game_area" class="display_off">
      <div id="game_board"></div>
      <div id="game_info"></div>
    </div>
  </div>

  <!-- ボットに勝ったとき、名前を残すか聞く -->
  <div id="name_overlay" class="display_off">
    <div id="name_dialog">
      <div id="name_dialog_title">勝利！ 名前を残そう</div>
      <div id="name_dialog_text">この名前でランキングとゴーストに記録されます。<br>スキップすると自動でつけた名前になります。</div>
      <input id="name_input" type="text" maxlength="20" placeholder="名前 (20文字まで)">
      <div id="name_error"></div>
      <div id="name_buttons">
        <button id="name_submit">この名前で残す</button>
        <button id="name_skip">スキップ</button>
      </div>
    </div>
  </div>


</body>

</html>